#!/bin/sh
set -eu

# containerd runs GPU containers through the nvidia runtime, which nvidia-ctk
# registers in its config.
if command -v nvidia-ctk >/dev/null 2>&1; then
    nvidia-ctk runtime configure --runtime=containerd \
        --config=/etc/containerd/config.toml
    echo "Configured NVIDIA container runtime for containerd"
fi

# The real runc is kept as /usr/sbin/runc.real, where cvm-runtime-init binds
# its runc-nvidia wrapper; without it every GPU container fails at task
# creation. The package installs runc under /usr/sbin or /usr/bin depending
# on the snapshot.
if [ ! -e /usr/sbin/runc.real ]; then
    if [ -f /usr/sbin/runc ]; then
        cp -a /usr/sbin/runc /usr/sbin/runc.real
    elif [ -f /usr/bin/runc ]; then
        cp -a /usr/bin/runc /usr/sbin/runc.real
    else
        echo "FATAL: no runc binary found to freeze as runc.real" >&2
        exit 1
    fi
fi

. /usr/lib/enclave-os/postinst-common.sh
systemctl enable gpu-cc-ready.service
