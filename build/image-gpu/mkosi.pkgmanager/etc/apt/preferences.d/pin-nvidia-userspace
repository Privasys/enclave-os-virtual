# Hold the NVIDIA 595-server userspace at the version of the CC kernel
# modules that actually load (the signed bundle from the cvm-images kernel-v*
# release, nvidia-cc-bundle-signed-595.91.07-7.0.0-38-generic). libcuda,
# nvidia-smi and the firmware must match the loaded module exactly, or the
# GPU never comes up.
#
# The image snapshots every pocket, but a later snapshot bump can still carry
# a newer 595-server userspace than the bundle. This pin turns that into a
# build failure instead of a GPU that never initialises.
#
# When cvm-images ships a bundle for a newer driver, bump this with it.
Package: *nvidia*-595-server*
Pin: version 595.91.07*
Pin-Priority: 1001
