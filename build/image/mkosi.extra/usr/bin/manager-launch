#!/bin/bash
# Launch wrapper for manager.service.
#
# The environment is read here, not by systemd: early in boot systemd may
# not load `EnvironmentFile=-/data/manager.env` into the unit for minutes
# although the file is readable, and an unexpanded ${CA_CERT:-...} would
# reach Caddy. This process runs after data.mount with the host mount view,
# so sourcing the file here works on the first start.
set -u

# Pull in the per-machine config written by manager-bootstrap at approval.
set -a
[ -r /data/manager.env ] && . /data/manager.env
set +a

exec /usr/bin/manager serve \
    --ca-cert "${CA_CERT:-/data/ca.crt}" \
    --ca-key "${CA_KEY:-/data/ca.key}" \
    --caddy-listen :443 \
    --extensions-dir /run/manager/extensions \
    --machine-name "${MACHINE_NAME:-$(hostname)}" \
    --hostname "${HOSTNAME_SUFFIX:-}" \
    --platform-hostname "${PLATFORM_HOSTNAME:-}" \
    --proxy-url "${PROXY_URL:-http://localhost:8080}" \
    --dek-origin-file /run/luks/dek-origin \
    --mgmt-url "${MGMT_URL:-}" \
    --enclave-id "${ENCLAVE_ID:-}" \
    --enclave-token "${ENCLAVE_TOKEN:-}" \
    --tunnel-gateways "${TUNNEL_GATEWAYS:-}" \
    --tunnel-server-name "${TUNNEL_SERVER_NAME:-}" \
    --proxy-protocol-from "${PROXY_PROTOCOL_FROM:-}" \
    --log-level info
